{
  "name": "BandProject sample processor",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postStartCommand": "mkdir -p .codespaces-runtime && nohup bash scripts/run-codespaces-sample.sh >.codespaces-runtime/launcher.log 2>&1 &",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "BandProject sample web app",
      "onAutoForward": "openPreview",
      "visibility": "public"
    }
  }
}
